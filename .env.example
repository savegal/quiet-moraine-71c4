# Get the Telegram token from @BotFather. Add Tokora keys in /admin.
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_TOKEN_HERE
# Optional legacy key for the primary cabinet.
TOKORA_API_KEY=
OWNER_ID=123456789
TOKORA_BASE_URL=https://tokora.online
DATABASE_PATH=data/proxima.sqlite3
# Enable only after testing rights, external quotas and the terms of both services.
ENABLE_TASK_DISPATCH=false
MAX_ACTIVE_TASKS=5
BOT_TIMEZONE=Asia/Jerusalem
POLL_SECONDS=5
UPSTREAM_TIMEOUT=25

# Per-user safety quotas for the shared upstream workspace.
MAX_TASKS_PER_DAY=100
MAX_OPEN_TASKS=3
# Optional comma-separated order modes restricted to the owner (e.g. fetch,feedwarm).
RESTRICTED_MODES=
