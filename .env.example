# Get Telegram token from @BotFather; Tokora key from your own dashboard.
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_TOKEN_HERE
TOKORA_API_KEY=PUT_TOKORA_BEARER_KEY_HERE
OWNER_ID=123456789
TOKORA_BASE_URL=https://tokora.online
DATABASE_PATH=data/proxima.sqlite3
# Enable only after testing rights, external quotas and the terms of both services.
ENABLE_TASK_DISPATCH=false
# Optional one-time Stars tariffs. Example: 1:100,2:180,7:500,30:1500
STARS_PLANS=
# Legacy single tariff (0 disables it).
STARS_30D_PRICE=0
SUBSCRIPTION_DAYS=30
BOT_TIMEZONE=Asia/Jerusalem
POLL_SECONDS=5
UPSTREAM_TIMEOUT=25

# Per-user safety quotas for the shared upstream workspace.
MAX_TASKS_PER_DAY=20
MAX_OPEN_TASKS=3
